{
  "name": "sanatorio-42-back",
  "version": "1.0.0",
  "description": "Backend de Sanatorio 42: login con la API de 42 y consulta de quién puede ayudarte",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc --build tsconfig.build.json",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "tsx --env-file=.env scripts/migrate-once.ts",
    "db:cache": "tsx --env-file=.env scripts/cache-info.ts",
    "cache:purge": "tsx --env-file=.env scripts/purge-cache.ts",
    "cache:flush": "tsx --env-file=.env scripts/flush-cache.ts",
    "madrid:seed": "tsx --env-file=.env scripts/seed-madrid.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "fastify": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.6",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8"
  }
}
