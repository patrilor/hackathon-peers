# ─────────────────────────────────────────────────────────────────────────────
# Backend de Sanatorio 42 — variables de entorno
#
# Copia este archivo a `.env` y rellénalo. El `.env` está en el .gitignore:
# NUNCA lo subas a git.
# ─────────────────────────────────────────────────────────────────────────────

# --- API de 42 ---------------------------------------------------------------
# Client ID (UID) y Secret de tu aplicación OAuth.
# Los tienes en https://profile.intra.42.fr/oauth/applications/<TU_ID>
# El Secret es una credencial real: no lo compartas ni lo pegues en un slide.
FORTY_TWO_UID=
FORTY_TWO_SECRET=

# Raíz de la API y endpoint de token. Se declaran aquí (y no en el código)
# para poder apuntar a un servidor simulado en los tests de integración.
FORTY_TWO_API_BASE=https://api.intra.42.fr
FORTY_TWO_TOKEN_URL=https://api.intra.42.fr/oauth/token

# OBLIGATORIA. La API de 42 responde 403 a las peticiones sin User-Agent, y el
# cuerpo viene vacío, así que el error es muy confuso si no sabes esto.
FORTY_TWO_USER_AGENT=sanatorio-42-backend/1.0 (+https://github.com/patrilor/hackathon-peers)

# --- Servidor ----------------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# --- Frontend ----------------------------------------------------------------
# Origen(es) del front a los que se permite CORS con credenciales.
# OJO: CORS con credenciales es incompatible con `*`. Pon la URL exacta.
# Separa varios orígenes con comas o espacios.
# En desarrollo es el puerto de Vite; en producción, tu dominio real.
FRONTEND_ORIGINS=http://localhost:5173

# --- OAuth -------------------------------------------------------------------
# Callback de OAuth. Debe estar REGISTRADA carácter a carácter en el panel de 42.
# Para desarrollo: http://localhost:3000/auth/callback
FORTY_TWO_REDIRECT_URI=http://localhost:3000/auth/callback

# Clave para firmar las cookies de sesión. Mínimo 16 caracteres.
# Genera una con:  openssl rand -base64 48
SESSION_SECRET=

# A dónde vuelve el usuario tras iniciar sesión (normalmente, el front).
FRONTEND_URL=http://localhost:5173

# --- Base de datos -----------------------------------------------------------
# Ruta del fichero SQLite. Se crea solo si no existe.
DATABASE_PATH=data/sanatorio.db

# --- Campus ------------------------------------------------------------------
# Madrid = 22. Common Core = 21.
CAMPUS_ID=22
CURSUS_ID=21

# --- Sincronización con la API de 42 -----------------------------------------
# La API limita a 2 peticiones/segundo y 1200/hora. 0.55 s ≈ 1.8 req/s.
API_REQUEST_DELAY_SECONDS=0.55

# Timeout normal. El de ubicaciones (API_TIMEOUT_HEAVY_MS) necesita más:
# con Madrid se acerca al minuto.
API_TIMEOUT_MS=30000
API_TIMEOUT_HEAVY_MS=120000

# Cuánto tiempo se consideran frescos los datos.
# Las ubicaciones caducan rápido (se va de guardia al salir del campus);
# los proyectos en curso cambian mucho menos.
CACHE_TTL_CAMPUS_SECONDS=60
CACHE_TTL_PROJECTS_SECONDS=900

# Peticiones por página (máximo de la API: 100).
PAGE_SIZE=100

# Tope de peticiones por minuto de nuestro propio sincronizador.
# Evita ráfagas. Con 550 ms entre llamadas ya se llega a unas 109/min.
SYNC_REQUESTS_PER_MINUTE=100

# Tope de peticiones por hora. Este es el límite REAL de la API de 42: pasarse
# devuelve 429 Spam Rate Limit Exceeded y, si se insiste, cierran la aplicación.
# El de porMinute no protege la cuota (100/min serían 6000/h), por eso existe
# este. Bajarlo si la app comparte credenciales con alguien más.
SYNC_REQUESTS_PER_HOUR=1200